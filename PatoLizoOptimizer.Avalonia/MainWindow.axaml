<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 x:Class="PatoLizoOptimizer.MainWindow" Title="Ducktimizer Pro" Icon="/Assets/logo.ico"
 Width="790" Height="595" MinWidth="790" MinHeight="595" MaxWidth="790" MaxHeight="595"
 CanResize="False" Background="#0F1418" FontFamily="Segoe UI">
 <Window.Styles>
  <Style Selector="TextBlock"><Setter Property="Foreground" Value="#F4FAFD"/></Style>
  <Style Selector="Border.panel"><Setter Property="Background" Value="#151A1F"/><Setter Property="BorderBrush" Value="#30373D"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="28"/></Style>
  <Style Selector="Border.card"><Setter Property="Background" Value="#1D2328"/><Setter Property="BorderBrush" Value="#343C42"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="15"/><Setter Property="Padding" Value="16,12"/></Style>
  <Style Selector="Button"><Setter Property="CornerRadius" Value="12"/><Setter Property="Padding" Value="16,10"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
  <Style Selector="Button.primary"><Setter Property="Background" Value="#DDF5FF"/><Setter Property="Foreground" Value="#10191E"/></Style>
  <Style Selector="Button.secondary"><Setter Property="Background" Value="#293137"/><Setter Property="Foreground" Value="#DCECF3"/></Style>
  <Style Selector="ToggleSwitch"><Setter Property="OnContent" Value=""/><Setter Property="OffContent" Value=""/><Setter Property="MinWidth" Value="46"/><Setter Property="HorizontalAlignment" Value="Right"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
  <Style Selector="ComboBox.compact"><Setter Property="Background" Value="#1D2328"/><Setter Property="Foreground" Value="#DDF5FF"/><Setter Property="BorderBrush" Value="#39434A"/><Setter Property="CornerRadius" Value="10"/><Setter Property="MinHeight" Value="34"/></Style>
 </Window.Styles>

 <Border Classes="panel" Margin="8" Padding="21,18">
  <Grid RowDefinitions="58,*,70,48" RowSpacing="10">
   <Grid ColumnDefinitions="*,Auto,46">
    <StackPanel VerticalAlignment="Center" Spacing="1">
     <TextBlock Text="Ducktimizer Pro" FontSize="18" FontWeight="Bold"/>
     <TextBlock Text="Poucas coisas. Muita diferença." Foreground="#6F9DC2" FontSize="11"/>
    </StackPanel>
    <ComboBox x:Name="PresetBox" Grid.Column="1" Classes="compact" Width="116" Margin="0,0,15,0" VerticalAlignment="Center" SelectedIndex="1" SelectionChanged="Preset_Changed">
     <ComboBoxItem Content="Low"/><ComboBoxItem Content="Medium"/><ComboBoxItem Content="High"/><ComboBoxItem Content="Ultra"/><ComboBoxItem Content="Debloat"/>
    </ComboBox>
    <Canvas Grid.Column="2" Width="38" Height="36" VerticalAlignment="Center">
     <Path Data="M 5,27 A 14,14 0 0 1 33,27" Stroke="#DDF5FF" StrokeThickness="3" StrokeLineCap="Round"/>
     <Path Data="M 19,27 L 27,17" Stroke="#DDF5FF" StrokeThickness="3" StrokeLineCap="Round"/>
     <Ellipse Canvas.Left="16.5" Canvas.Top="24.5" Width="5" Height="5" Fill="#DDF5FF"/>
    </Canvas>
   </Grid>

   <Grid Grid.Row="1" ColumnDefinitions="*,*" RowDefinitions="*,*,*,*" ColumnSpacing="11" RowSpacing="9">
    <Border Classes="card"><Grid ColumnDefinitions="*,Auto"><StackPanel VerticalAlignment="Center" Spacing="2"><TextBlock Text="Visual limpo" FontSize="14" FontWeight="SemiBold"/><TextBlock Text="Transparência e animações" Foreground="#6F9DC2" FontSize="11"/></StackPanel><ToggleSwitch x:Name="VisualSwitch" Grid.Column="1" IsChecked="True"/></Grid></Border>
    <Border Classes="card" Grid.Column="1"><Grid ColumnDefinitions="*,Auto"><StackPanel VerticalAlignment="Center" Spacing="2"><TextBlock Text="Modo gamer" FontSize="14" FontWeight="SemiBold"/><TextBlock Text="Game Mode e captura" Foreground="#6F9DC2" FontSize="11"/></StackPanel><ToggleSwitch x:Name="GamingSwitch" Grid.Column="1" IsChecked="True"/></Grid></Border>
    <Border Classes="card" Grid.Row="1"><Grid ColumnDefinitions="*,Auto"><StackPanel VerticalAlignment="Center" Spacing="2"><TextBlock Text="Alto desempenho" FontSize="14" FontWeight="SemiBold"/><TextBlock Text="Plano de energia" Foreground="#6F9DC2" FontSize="11"/></StackPanel><ToggleSwitch x:Name="PowerSwitch" Grid.Column="1" IsChecked="True"/></Grid></Border>
    <Border Classes="card" Grid.Row="1" Grid.Column="1"><Grid ColumnDefinitions="*,Auto"><StackPanel VerticalAlignment="Center" Spacing="2"><TextBlock Text="Privacidade" FontSize="14" FontWeight="SemiBold"/><TextBlock Text="Telemetria e histórico" Foreground="#6F9DC2" FontSize="11"/></StackPanel><ToggleSwitch x:Name="PrivacySwitch" Grid.Column="1"/></Grid></Border>
    <Border Classes="card" Grid.Row="2"><Grid ColumnDefinitions="*,Auto"><StackPanel VerticalAlignment="Center" Spacing="2"><TextBlock Text="Windows seco" FontSize="14" FontWeight="SemiBold"/><TextBlock Text="Fonte, sombras e efeitos mínimos" Foreground="#6F9DC2" FontSize="11"/></StackPanel><ToggleSwitch x:Name="DrySwitch" Grid.Column="1"/></Grid></Border>
    <Border Classes="card" Grid.Row="2" Grid.Column="1"><Grid ColumnDefinitions="*,Auto"><StackPanel VerticalAlignment="Center" Spacing="2"><TextBlock Text="Pesquisa enxuta" FontSize="14" FontWeight="SemiBold"/><TextBlock Text="Sem Bing, destaques e sugestões" Foreground="#6F9DC2" FontSize="11"/></StackPanel><ToggleSwitch x:Name="SearchSwitch" Grid.Column="1"/></Grid></Border>
    <Border Classes="card" Grid.Row="3"><Grid ColumnDefinitions="*,Auto"><StackPanel VerticalAlignment="Center" Spacing="2"><TextBlock Text="Debloat extremo" FontSize="14" FontWeight="SemiBold"/><TextBlock Text="Apps, IA, Widgets e anúncios" Foreground="#6F9DC2" FontSize="11"/></StackPanel><ToggleSwitch x:Name="DebloatSwitch" Grid.Column="1"/></Grid></Border>
    <Border Classes="card" Grid.Row="3" Grid.Column="1"><Grid ColumnDefinitions="*,Auto"><StackPanel VerticalAlignment="Center" Spacing="2"><TextBlock Text="Sistema leve" FontSize="14" FontWeight="SemiBold"/><TextBlock Text="Apps e tarefas em segundo plano" Foreground="#6F9DC2" FontSize="11"/></StackPanel><ToggleSwitch x:Name="BackgroundSwitch" Grid.Column="1"/></Grid></Border>
   </Grid>

   <Border Grid.Row="2" Background="#1D2429" BorderBrush="#343D43" BorderThickness="1" CornerRadius="15" Padding="16,9">
    <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto">
     <Ellipse Width="8" Height="8" Fill="#55E5A4" VerticalAlignment="Center"/>
     <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center" Spacing="1"><TextBlock x:Name="StateTitle" Text="Pronto para acelerar" FontSize="14" FontWeight="SemiBold"/><TextBlock x:Name="StateDetail" Text="Backup local antes das alterações" Foreground="#668CB0" FontSize="11"/></StackPanel>
     <TextBlock Grid.Column="2" Text="REVERSÍVEL" Foreground="#BFEAFF" FontSize="10" FontWeight="Bold" VerticalAlignment="Center"/>
     <ProgressBar x:Name="ApplyProgress" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Margin="12,6,0,0" Height="4" Minimum="0" Maximum="100" Value="0" IsVisible="False"/>
    </Grid>
   </Border>

   <Grid Grid.Row="3" ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="9">
    <TextBlock Text="Ducktimizer Pro  •  v3.4.2" Foreground="#65737C" FontSize="11" VerticalAlignment="Center"/>
    <Button x:Name="UpdateButton" Grid.Column="1" Classes="secondary" Content="Nova versão disponível" IsVisible="False" Click="Update_Click"/>
    <Button x:Name="DeactivateButton" Grid.Column="2" Classes="secondary" Content="Restaurar" Click="Deactivate_Click"/>
    <Button x:Name="ActivateButton" Grid.Column="3" Classes="primary" Content="Ativar selecionadas  →" Click="Activate_Click"/>
   </Grid>
  </Grid>
 </Border>
</Window>
